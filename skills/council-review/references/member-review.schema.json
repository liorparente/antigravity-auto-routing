{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemberReview",
  "type": "object",
  "required": ["schema_version", "round", "envelope_hash", "vote", "findings"],
  "properties": {
    "schema_version": {"type": "string"},
    "round": {"type": "integer"},
    "envelope_hash": {"type": "string"},
    "candidate_hash": {"type": "string"},
    "vote": {"type": "string", "enum": ["approve", "revise", "block", "abstain"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "claim"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "category": {"type": "string"},
          "claim": {"type": "string"},
          "evidence_references": {"type": "array", "items": {"type": "string"}},
          "recommendation": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "proposed_changes": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "explicit_dissent": {"type": "string"}
  }
}
